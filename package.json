{
  "name": "jsaqa-task8",
  "version": "1.0.0",
  "description": "Eighth task for the Web UI test automation course",
  "homepage": "https://github.com/k-o-white/jsaqa-task8#readme",
  "bugs": {
    "url": "https://github.com/k-o-white/jsaqa-task8/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/k-o-white/jsaqa-task8.git"
  },
  "license": "ISC",
  "author": "Kirill Burilichev",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cy:main-page": "dotenv -- cypress run --group main-page --ci-build-id $CYPRESS_CI_BUILD_ID --spec 'cypress/e2e/main-page.cy.js' --record",
    "cy:admin-login": "dotenv -- cypress run --group admin-login --ci-build-id $CYPRESS_CI_BUILD_ID --spec 'cypress/e2e/admin-login.cy.js' --record",
    "cy:booking": "dotenv -- cypress run --group booking --ci-build-id $CYPRESS_CI_BUILD_ID --spec 'cypress/e2e/booking.cy.js' --record",
    "cy:all": "npm run cy:main-page & npm run cy:admin-login & npm run cy:booking",
    "cy:parallel": "export CYPRESS_CI_BUILD_ID=local-$RANDOM && npm run cy:all"
  },
  "devDependencies": {
    "cypress": "^16.2.0",
    "dotenv-cli": "^11.1.0"
  }
}
