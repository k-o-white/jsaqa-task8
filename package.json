  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cy:main-page": "cypress run --spec 'cypress/e2e/main-page.cy.js' --record --key $CYPRESS_RECORD_KEY",
    "cy:admin-login": "cypress run --spec 'cypress/e2e/admin-login.cy.js' --record --key $CYPRESS_RECORD_KEY",
    "cy:booking": "cypress run --spec 'cypress/e2e/booking.cy.js' --record --key $CYPRESS_RECORD_KEY",
    "cy:all": "npm run cy:main-page & npm run cy:admin-login & npm run cy:booking",
    "cy:parallel": "dotenv -- npm run cy:all"
  },
  "devDependencies": {
    "cypress": "^16.2.0",
    "dotenv-cli": "^11.1.0"
  }
}
